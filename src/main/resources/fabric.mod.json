{
	"schemaVersion": 1,
	"id": "minekit",
	"version": "${version}",
	"name": "Minekit",
	"description": "Client-side utility suite: inventory sorting with hotbar layout, crafting planner, resource tracker, storage finder, smart deposit, loadouts, quick actions and blueprints with building tools. Works on any server; nothing needs to be installed there.",
	"icon": "assets/minekit/icon.png",
	"authors": [
		"David Einenkel"
	],
	"contact": {
		"homepage": "https://github.com/nordavid/Minekit",
		"sources": "https://github.com/nordavid/Minekit",
		"issues": "https://github.com/nordavid/Minekit/issues"
	},
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.nordavid.minekit.MinekitClient"
		],
		"modmenu": [
			"io.github.nordavid.minekit.compat.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=25",
		"fabric-api": ">=${fabric_api_min}"
	}
}
